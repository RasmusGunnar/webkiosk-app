VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
# Legacy VITE_SUPABASE_ANON_KEY is also supported. Never use a service_role key.

# Set after the production domain is verified. Required for native release builds.
VITE_PUBLIC_APP_URL=https://YOUR_PUBLIC_DOMAIN
# Enable only after APNs/FCM and device tests are complete.
VITE_NATIVE_PUSH_ENABLED=false
